# Copy this file to .env (or .env.local) and adjust as needed.
# Vite only reads .env files at the project root, and only variables
# prefixed with VITE_ are exposed to the frontend code.

# Where your Quarkus backend is running. Ignored entirely when
# VITE_USE_MOCK_API=true below.
VITE_API_BASE_URL=http://localhost:8080

# Set to "true" to run the whole app against an in-memory fake backend —
# no Java server required. Every screen (Home, Setup, Draft board) works
# the same either way. Useful for frontend-only development, demos, or
# just trying things out without standing up Quarkus.
VITE_USE_MOCK_API=false
