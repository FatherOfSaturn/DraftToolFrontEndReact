# Copy this file to .env (or .env.local) and adjust as needed.
# Vite only reads .env files at the project root, and only variables
# prefixed with VITE_ are exposed to the frontend code.

# Where your Quarkus backend is running. Game calls use the in-memory
# implementation when VITE_USE_MOCK_API=true; account calls remain real.
VITE_API_BASE_URL=http://localhost:8080

# Set to "true" to use generated in-memory game data for draft development.
# This does not mock Google login, accounts, saved decks, or the complete
# backend pack merge lifecycle.
VITE_USE_MOCK_API=false

# Google OAuth Client ID for Google Sign-In. Get one from
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Set to "true" to skip the login requirement for /account in development.
# ALWAYS leave this "false" or unset in production.
VITE_SKIP_AUTH=false
